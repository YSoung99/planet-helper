# Allowlist: everything is ignored unless listed below, so hunting records,
# settings, logs, screenshots and the virtualenv can never be committed.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/.github/
!/*.py
!/PlanetEXP.spec

!/exp_table.json
!/requirements*.txt
!/requirements*.lock
!/개선내역.md
!/사용방법.md
!/경험치표_근거.md
!/install-linux.sh
!/mac_update_swap.sh
!/tests/
!/native/
!/models/
!/references/

# Never commit inside allowed folders either
__pycache__/
*.pyc
*.png
*.jpg
*.jpeg
*.log
*.jsonl
*.csv
/PlanetEXP.icns
!/planet-helper-icon.png
# An anonymized HUD-only fixture for the Lv.151 regression test.
!/tests/fixtures/classic-lv151.png
/native/KeyRepeatHelper
/native/ocr-rust/target/
